@model Computador
@{
    ViewData["Title"] = "Novo computador";
}

<h1>Novo computador</h1>
<p>Todos os campos são obrigatórios.</p>

<form asp-controller="Computadores" asp-action="Criar" method="post">
    <div asp-validation-summary="ModelOnly" class="erro" role="alert"></div>

    <div class="campo">
        <label asp-for="Nome"></label>
        <input asp-for="Nome" maxlength="100" required />
        <span asp-validation-for="Nome" class="erro"></span>
    </div>
    <div class="campo">
        <label asp-for="Marca"></label>
        <input asp-for="Marca" maxlength="60" required />
        <span asp-validation-for="Marca" class="erro"></span>
    </div>
    <div class="campo">
        <label asp-for="Processador"></label>
        <input asp-for="Processador" maxlength="100" required />
        <span asp-validation-for="Processador" class="erro"></span>
    </div>
    <div class="campo">
        <label asp-for="MemoriaRamGb"></label>
        <input asp-for="MemoriaRamGb" type="number" min="1" max="2048" step="1" required />
        <span asp-validation-for="MemoriaRamGb" class="erro"></span>
    </div>
    <div class="campo">
        <label asp-for="ArmazenamentoGb"></label>
        <input asp-for="ArmazenamentoGb" type="number" min="1" max="100000" step="1" required />
        <span asp-validation-for="ArmazenamentoGb" class="erro"></span>
    </div>

    <button type="submit">Salvar computador</button>
    <a asp-action="Index">Voltar</a>
</form>
